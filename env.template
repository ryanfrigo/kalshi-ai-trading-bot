# Kalshi API Configuration
# Get your API key from: https://kalshi.com/account/settings
KALSHI_API_KEY=your_kalshi_api_key_here

# OpenRouter API Configuration — one key for any model on OpenRouter
# (the bot calls a single model per decision; choose it in your config)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Path to your Kalshi RSA private key (default: kalshi_private_key.pem in the project root)
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# Daily LLM spend cap in USD
DAILY_AI_COST_LIMIT=10
